# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_API_BASE_URL: Base URL of the PHP REST API as seen by the
# browser. Leave unset to use the Next.js dev rewrite
# (http://127.0.0.1:8080/api/v1) or the same-origin /api/v1 via a reverse
# proxy on deployed hosts. For test.architex.co.za typically set to either
# https://api.architex.co.za/api/v1 (separate origin, CORS restricted) or
# leave unset with the reverse proxy forwarding /api/* .
# NEXT_PUBLIC_API_BASE_URL="https://api.architex.co.za/api/v1"

# Wingman bring-your-own-API (BYOAPI) providers.
# Users can also supply their OWN keys per-session from the Wingman AI Engine
# settings panel (stored in the browser only, never persisted server-side):
#   - OpenAI (ChatGPT subscription): OpenAI-compatible /chat/completions
#   - NVIDIA NIM (vision models):    OpenAI-compatible /chat/completions
#   - Gemini:                        @google/genai (uses GEMINI_API_KEY above)
# The route falls back to a simulated engine when no key is available.
# Optional server-side defaults (used when the user has not set a key):
# OPENAI_API_KEY="MY_OPENAI_API_KEY"
# NVIDIA_API_KEY="MY_NVIDIA_NIM_API_KEY"
NEXT_PUBLIC_ENGINEERING_WORKFLOW_V2=false
