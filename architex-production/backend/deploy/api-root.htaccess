<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^env\.local\.php$ - [F,L]

  # Phase 0 immutable containment API. Keep this rule before the legacy
  # gateway so /api/v1 requests execute the generated calculator policy.
  RewriteRule ^api/v1(?:/.*)?$ phase0-backend/public/index.php [L,QSA]

  RewriteRule ^api/?$ index.php [L,QSA]
  RewriteRule ^api/(.*)$ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

DirectoryIndex index.php
Options -Indexes
