# Architex OS backend environment (PHP API)
# Copy to `.env` and load via your host's mechanism (cPanel "Application Manager"
# environment UI, `SetEnv` in .htaccess is NOT used — the API reads process env).
# All values fall back to safe local-dev defaults in backend/config.php.

# REQUIRED for anything but local development — the API fails closed (503) for
# JWT routes when the placeholder is left in place.
APP_ENV="local"
ARCHITEX_DATA_MODE="local"
JWT_SECRET="change-this-before-production"

# Data isolation is mandatory outside local development:
# test.architex.co.za: ARCHITEX_DATA_MODE="prototype" (demo seeding allowed)
# architex.co.za:      ARCHITEX_DATA_MODE="production" (demo data rejected)

# MariaDB connection (cPanel MySQL/MariaDB: create both under one cPanel DB user)
DB_HOST="localhost"
DB_NAME="architex_os"
DB_USER="architex_user"
DB_PASS=""

# CORS: restrict to the deployed frontend origin once live.
# e.g. https://test.architex.co.za (comma-separated list is NOT supported — single origin)
CORS_ORIGIN="*"
